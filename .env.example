APP_NAME=nearFind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# The compiled rung has exactly one cache store: the D1-backed `database` store.
# `file` (the Laravel default here) has no filesystem at the edge, and the login
# throttle reads/writes the limiter through it - with `file` the limiter is
# silently inert in the Worker. Needs the `cache` + `cache_locks` tables, which
# the app's migrations already create.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default: the `log` driver writes the verification mail to the log and to
# the in-memory `sent` list — no API key, nothing leaves the machine. Production
# overrides this to `resend` in .github/workflows/deploy.yml, which also needs the
# Worker secret RESEND_API_KEY (`wrangler secret put RESEND_API_KEY`); its absence
# never fails the build, only the send.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The sender of the verification mail. `nietzsc.de` is the Resend-verified domain;
# a local `log`/`array` run does not deliver, so the value only matters at deploy.
MAIL_FROM_ADDRESS="noreply@nietzsc.de"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SEAL_ISSUER="${APP_NAME}"
SEAL_AUDIENCE=web
SEAL_KEY_ID=local
SEAL_KEY=
SEAL_SESSION_TTL=12h
SEAL_REMEMBER_TTL=30d
SEAL_CLOCK_TOLERANCE=60

NEARFIND_AUTH_EMAIL=warga@nearfind.test
NEARFIND_AUTH_NAME="nearFind"
NEARFIND_AUTH_PASSWORD_HASH=

NEARFIND_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
